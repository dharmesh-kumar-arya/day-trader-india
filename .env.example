# ==============================================================================
# Day Trader India - Environment Configuration Template
# Copy this file to .env and configure your preferences.
# Note: By default, the app runs safely in Paper Trading simulator mode!
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# ------------------------------------------------------------------------------
# DhanHQ API Credentials (Optional - required only for Live Dhan Execution)
# Obtain from https://web.dhan.co -> DhanHQ & APIs
# Note: Access tokens expire daily at 06:00 AM IST.
# ------------------------------------------------------------------------------
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Trading Defaults & Capital Protection
# ------------------------------------------------------------------------------
# Set to 'false' only if you intend to send real money orders to Dhan by default
PAPER_TRADING_DEFAULT=true

# Initial Virtual Capital for Paper Simulator in INR (Default: ₹2,00,000)
PAPER_CAPITAL_INR=200000.0

# Maximum Risk per Individual Trade in INR (Default: ₹1,000)
DEFAULT_MAX_RISK_PER_TRADE_INR=1000.0

# Maximum Cumulative Daily Loss Limit in INR (Default: ₹3,000)
# Hard risk ceiling: Once hit, all new entries are blocked for the rest of the day
DEFAULT_MAX_DAILY_LOSS_INR=3000.0

# Minimum Reward-to-Risk ratio required by Pre-Flight Gatekeeper
MIN_REWARD_RISK_RATIO=1.5

# Intraday MIS Leverage multiplier enforced under SEBI regulations (Equities: 5x)
DEFAULT_LEVERAGE_MIS=5.0

# ------------------------------------------------------------------------------
# Market Timings (Asia/Kolkata - Indian Standard Time)
# ------------------------------------------------------------------------------
# Opening Range Breakout calculation window cutoff (09:15 - 09:30 IST)
ORB_CUTOFF_TIME=09:30

# Gatekeeper blocks all fresh trade entries after this time (Default: 14:30 IST)
NO_ENTRIES_AFTER_TIME=14:30

# Hard Intraday Auto-Squareoff Daemon trigger time (Default: 15:15 IST)
# Avoids Dhan broker penalty auto-squareoff charges (₹50 + GST)
AUTO_FLATTEN_TIME=15:15
