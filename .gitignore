# ==============================================================================
# Day Trader India - Git Ignore Rules
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*dhan_config.json
!backend/dhan_config.example.json

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/
*.manifest
*.spec

# SQLite Database & Trade Journal
backend/data/*.db
backend/data/*.db-journal
backend/data/*.sqlite
backend/data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Node.js & Frontend Artifacts
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary & Log Files
*.log
logs/
tmp/
temp/
